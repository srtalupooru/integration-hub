@page "/"
@inherits ApiPage
<PageTitle>Dashboard · Integration Hub</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR INTEGRATION LANDSCAPE</div><h1>Workspace overview</h1><p>A shared view of your systems, connections, and the definitions behind them.</p></div><MudButton Href="/import" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Import definition</MudButton></div>
<PageState Loading="Loading" Error="@Error" />
@if (_components is not null)
{
    <section class="panel"><div class="panel-heading"><h2>Component discovery</h2><a href="/components/new">Add a component →</a></div><div class="catalogue-modes"><a href="/components">@_components.Components components</a><a href="/discovered">@_components.Networks discovered integrations</a><span>@_components.Unlinked unlinked</span><span>@_components.Findings findings</span></div><p class="muted">Describe each API or function independently. Matching message declarations generate connected integration networks.</p></section>
}
@if (_dashboard is not null)
{
    <div class="metric-grid">
        @foreach (var metric in Metrics())
        { <div class="metric-card"><span>@metric.Label</span><MudIcon Icon="@metric.Icon" /><strong>@metric.Value</strong><small>@metric.Note</small></div> }
    </div>
    @if (_dashboard.TotalIntegrations == 0 && (_components?.Networks ?? 0) == 0)
    {
        <section class="empty-hero"><div class="empty-illustration" aria-hidden="true"><div class="empty-node"><MudIcon Icon="@Icons.Material.Outlined.Dns" /></div><span class="connector"></span><div class="empty-node center"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /></div><span class="connector"></span><div class="empty-node"><MudIcon Icon="@Icons.Material.Outlined.CloudQueue" /></div></div><span class="eyebrow">YOUR LANDSCAPE STARTS HERE</span><h2>No integrations have been documented yet.</h2><p>Turn a JSON or YAML definition into architecture, documentation,<br class="desktop-only" /> and a connected view of your enterprise.</p><div class="button-row"><MudButton Href="/import" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile">Import Integration Definition</MudButton><MudButton Href="/import?mode=create" Variant="Variant.Outlined" Color="Color.Primary">Create Integration</MudButton></div><a class="subtle-link" href="/api/schema" target="_blank">Explore the definition schema ↗</a></section>
        <div class="feature-grid"><article><span class="step-number">01</span><h3>Define your integration</h3><p>Describe systems, message flows, ownership, and operations in readable JSON or YAML.</p></article><article><span class="step-number">02</span><h3>See the whole picture</h3><p>Generate architecture and documentation from one validated definition.</p></article><article><span class="step-number">03</span><h3>Understand the impact</h3><p>Follow shared dependencies and discover which integrations a change could affect.</p></article></div>
    }
    else
    {
        <div class="dashboard-grid"><section class="panel"><div class="panel-heading"><h2>Recently updated</h2><a href="/integrations">View catalogue →</a></div>@foreach (var item in _dashboard.RecentlyUpdated) { <a class="integration-row" href="@($"/integrations/{item.Id}")"><span class="integration-icon"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /></span><span><strong>@item.Name</strong><small>@item.BusinessDomain · @item.Owner</small></span><span class="badge">@item.Status</span><time>@item.UpdatedAt.ToLocalTime().ToString("dd MMM")</time></a> }</section><section class="panel"><h2>Integrations by domain</h2>@foreach (var item in _dashboard.ByDomain) { <div class="count-row"><span>@(string.IsNullOrEmpty(item.Name) ? "Unspecified" : item.Name)</span><strong>@item.Count</strong></div> }</section><section class="panel"><h2>Lifecycle status</h2>@foreach (var item in _dashboard.ByStatus) { <div class="count-row"><span>@item.Name</span><strong>@item.Count</strong></div> }</section><section class="panel"><h2>Most referenced systems</h2>@if (_dashboard.MostReferencedSystems.Count == 0) { <p>No registered systems are referenced yet.</p> }@foreach (var item in _dashboard.MostReferencedSystems) { <div class="count-row"><a href="@($"/systems/{item.Name}")">@item.Name</a><strong>@item.Count integrations</strong></div> }</section></div>
    }
}
@code {
    private DashboardSummary? _dashboard;
    private ComponentDashboard? _components;
    protected override async Task LoadAsync()
    {
        _dashboard = await Api.GetAsync<DashboardSummary>("/api/dashboard");
        _components = await Api.GetAsync<ComponentDashboard>("/api/component-dashboard");
    }
    private IEnumerable<(string Label, int Value, string Note, string Icon)> Metrics()
    {
        yield return ("Authored integrations", _dashboard!.TotalIntegrations, "Complete integration definitions", Icons.Material.Outlined.AccountTree);
        yield return ("In production", _dashboard.ProductionIntegrations, "Production definitions", Icons.Material.Outlined.CheckCircle);
        yield return ("Registered systems", _dashboard.Systems, "Enterprise system catalogue", Icons.Material.Outlined.Dns);
        yield return ("Messages & events", _dashboard.Messages, "Unique message definitions", Icons.Material.Outlined.Forum);
        yield return ("High criticality", _dashboard.HighCriticalityIntegrations, "High and critical integrations", Icons.Material.Outlined.PriorityHigh);
        yield return ("Validation warnings", _dashboard.ValidationWarnings, "Findings to review", Icons.Material.Outlined.Rule);
    }
}
