@page "/discovered/{Id}"
@inherits ApiPage
<PageTitle>Discovered integration · Integration Hub</PageTitle>
<a class="breadcrumb" href="/integrations">← Integrations</a>
<PageState Loading="Loading" Error="@Error" />
@if (_view is not null)
{
    var i = _view.Integration;
    <div class="page-heading"><div><div class="eyebrow">DISCOVERED · @i.Environment</div><div class="page-title-row"><span class="page-symbol"><MudIcon Icon="@HubIcons.AutoGraph" /></span><h1>@i.Name</h1></div><p>@i.Sources.Count components connected through @i.Connections.Count HTTP calls and message routes.</p></div><MudButton OnClick="Refresh" StartIcon="@HubIcons.Refresh">Refresh</MudButton></div>
    <div class="detail-summary"><div><small>ENVIRONMENT</small><strong>@i.Environment</strong></div><div><small>COMPONENTS</small><strong>@i.Sources.Count</strong></div><div><small>CONNECTIONS</small><strong>@i.Connections.Count</strong></div><div><small>FINDINGS TO REVIEW</small><strong>@i.Issues.Count</strong></div></div>
    <div class="notice-strip"><MudIcon Icon="@HubIcons.AutoGraph" /><p>This integration is generated from your components. Edit a source component to update its connections.</p></div>
    <section class="panel detail-tabs"><MudTabs>
        <MudTabPanel Text="Overview"><div class="section-heading"><div><h2>How these components connect</h2><p>Follow the calls and messages between components. Open Connections for routing and handler details.</p></div></div><Diagram Markup="@_view.Diagram" /></MudTabPanel>
        <MudTabPanel Text="Connections">
            <div class="section-heading"><div><h2>From source to destination</h2><p>These connections are matched from the saved component definitions.</p></div></div>
            <div class="connection-list">@foreach (var c in i.Connections) {
                <article class="connection-card"><div class="connection-path"><div><small>From</small><a href="@($"/components/{c.ProducerId}")">@ComponentName(c.ProducerId)</a></div><span aria-hidden="true">→</span><div><small>To</small><a href="@($"/components/{c.ConsumerId}")">@ComponentName(c.ConsumerId)</a></div></div>
                    <p class="connection-message">@InteractionLabels.Describe(c)</p>
                    <div class="processing-evidence"><ProcessingReferences References="c.ProducedBy" Label="Possible producers" /><ProcessingReferences References="c.HandledBy" Label="Handled by" /></div>
                    <details class="quiet-details"><summary>Routing details</summary><dl class="technical-grid"><dt>Source declaration</dt><dd><code>@c.PublishBindingId</code></dd><dt>Destination declaration</dt><dd><code>@c.ConsumeBindingId</code></dd><dt>Channel</dt><dd>@c.Channel.Kind · @c.Channel.Name</dd><dt>Namespace</dt><dd>@c.Channel.Namespace</dd><dt>Delivery</dt><dd>@c.Delivery</dd>@if (c.Subscription is not null) { <dt>Subscription</dt><dd>@c.Subscription</dd> }</dl></details>
                </article>
            }</div>
        </MudTabPanel>
        @if (i.Processing.Count > 0) { <MudTabPanel Text="Handlers &amp; sagas">@foreach (var item in i.Processing) { <section class="mb-6"><h2 class="mb-4"><a href="@($"/components/{item.ComponentId}")">@item.ComponentName</a></h2><ComponentProcessingView Definition="item.Definition" /></section> }</MudTabPanel> }
        <MudTabPanel Text="Documentation"><DocumentationView Document="_view.Documentation" /></MudTabPanel>
        <MudTabPanel Text="Review"><div class="section-heading"><div><h2>Items to review (@i.Issues.Count)</h2><p>Each item explains a matching decision and suggests a next step.</p></div></div><DiscoveryFindings Issues="i.Issues" /></MudTabPanel>
    </MudTabs></section>
    <details class="panel content-disclosure mt-6"><summary>Source components &amp; exports</summary><h2 class="mt-4">Components in this integration</h2><p class="muted">Open a component to review or update its definition. Refresh this integration after saving changes.</p><div class="table-scroll"><table><thead><tr><th>Component</th><th>Revision</th><th>Verification</th></tr></thead><tbody>@foreach (var source in i.Sources) { <tr><td><a href="@($"/components/{source.Id}")">@source.Name</a></td><td>@source.Revision</td><td><details><summary>Definition fingerprint</summary><code>@source.DefinitionHash</code></details></td></tr> }</tbody></table></div><div class="button-row"><a href="@($"/api/discovery/{Id}/definition?format=yaml")" target="_blank">Snapshot YAML ↗</a><a href="@($"/api/discovery/{Id}/definition?format=json")" target="_blank">Snapshot JSON ↗</a><a href="@($"/api/discovery/{Id}/documentation?format=markdown")" target="_blank">Markdown documentation ↗</a><a href="/dependencies">Explore dependency impact →</a></div></details>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private DiscoveredIntegrationView? _view;
    protected override async Task LoadAsync() { _view = null; _view = await Api.GetAsync<DiscoveredIntegrationView>($"/api/discovery/{Uri.EscapeDataString(Id)}"); }
    private string ComponentName(string id) => _view?.Integration.Sources.FirstOrDefault(s => s.Id == id)?.Name ?? id;
    private Task Refresh() => ExecuteAsync(LoadAsync);
}
