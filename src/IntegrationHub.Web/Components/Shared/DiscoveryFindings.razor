@if (Issues.Count == 0) { <p class="muted">No discovery findings.</p> }
else
{
    <div class="table-scroll"><table><thead><tr><th>Component / binding</th><th>Finding</th><th>Next step</th></tr></thead><tbody>
        @foreach (var issue in Issues.Skip(_page * 30).Take(30))
        { <tr><td><a href="@($"/components/{issue.ComponentId}")">@issue.ComponentId</a><small>@issue.BindingId</small></td><td><span class="badge">@issue.Code</span><p>@issue.Message</p></td><td>@issue.Resolution</td></tr> }
    </tbody></table></div>
    @if (Issues.Count > 30) { <div class="pagination"><MudButton Disabled="@(_page == 0)" OnClick="@(() => _page--)">Previous</MudButton><span>Findings @(_page * 30 + 1)–@Math.Min((_page + 1) * 30, Issues.Count) of @Issues.Count</span><MudButton Disabled="@((_page + 1) * 30 >= Issues.Count)" OnClick="@(() => _page++)">Next</MudButton></div> }
}
@code {
    [Parameter] public IReadOnlyList<DiscoveryIssue> Issues { get; set; } = [];
    private int _page;
    protected override void OnParametersSet() { if (_page * 30 >= Issues.Count) _page = 0; }
}
