@inherits LayoutComponentBase
@inject HubApiClient Api
@inject NavigationManager Navigation
<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<a class="skip-link" href="#workspace-main">Skip to content</a>
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand-row">
            <a class="brand" href="/"><span class="brand-symbol"><MudIcon Icon="@HubIcons.AccountTree" /></span><span>Integration Hub</span></a>
            <button class="navigation-toggle" type="button" @onclick="@(() => _menuOpen = !_menuOpen)" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="workspace-navigation"><MudIcon Icon="@HubIcons.TableRows" />Menu</button>
        </div>
        <div id="workspace-navigation" class="sidebar-links @(_menuOpen ? "is-open" : "")" @onclick="@(() => _menuOpen = false)">
            <div class="workspace-label">WORKSPACE</div>
            <nav aria-label="Workspace">
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon"><MudIcon Icon="@HubIcons.SpaceDashboard" /></span><span class="nav-copy">Overview</span></NavLink>
                <a href="/integrations" class="@(CurrentSection == "Integrations" ? "active" : null)" aria-current="@(CurrentSection == "Integrations" ? "location" : null)"><span class="nav-icon"><MudIcon Icon="@HubIcons.AccountTree" /></span><span class="nav-copy">Integrations</span></a>
                <NavLink href="/components"><span class="nav-icon"><MudIcon Icon="@HubIcons.Widgets" /></span><span class="nav-copy">Components</span></NavLink>
                <NavLink href="/systems"><span class="nav-icon"><MudIcon Icon="@HubIcons.Dns" /></span><span class="nav-copy">Systems</span></NavLink>
            </nav>
            <div class="workspace-label">EXPLORE</div>
            <nav aria-label="Explore">
                <a href="/component-messages" class="@(CurrentSection == "Messages" ? "active" : null)" aria-current="@(CurrentSection == "Messages" ? "location" : null)"><span class="nav-icon"><MudIcon Icon="@HubIcons.Forum" /></span><span class="nav-copy">Messages</span></a>
                <NavLink href="/dependencies"><span class="nav-icon"><MudIcon Icon="@HubIcons.Hub" /></span><span class="nav-copy">Connections &amp; impact</span></NavLink>
            </nav>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar"><span class="topbar-title">Workspace <span>/</span> <strong>@CurrentSection</strong></span><div class="topbar-right"><a href="/search" class="top-search"><MudIcon Icon="@HubIcons.Search" Size="Size.Small" /> Search catalogue</a><span class="environment"><i></i>@(Api.Session?.Environment ?? "Workspace")</span><span class="user-avatar" title="@(Api.Session?.Name ?? "User")">@(Api.Session?.Name.FirstOrDefault().ToString() ?? "U")</span></div></header>
        <main id="workspace-main" class="page-content" tabindex="-1"><ErrorBoundary><ChildContent>@Body</ChildContent><ErrorContent><MudAlert Severity="Severity.Error">This view could not load. <a href="">Reload</a> to try again.</MudAlert></ErrorContent></ErrorBoundary></main>
    </div>
</div>
@code {
    private bool _menuOpen;
    private string CurrentSection => Navigation.ToBaseRelativePath(Navigation.Uri).Split(new[] { '?', '#' }, 2)[0].Split('/')[0] switch
    {
        "integrations" or "discovered" or "import" => "Integrations", "components" => "Components",
        "systems" => "Systems", "messages" or "component-messages" => "Messages",
        "dependencies" => "Connections & impact", "search" => "Search", _ => "Overview"
    };
    private readonly MudTheme _theme = new() { PaletteLight = new PaletteLight { Primary = "#202124", Secondary = "#267354", Background = "#ffffff", Surface = "#ffffff", TextPrimary = "#202124", TextSecondary = "#666b73" }, Typography = new Typography { Default = new DefaultTypography { FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] } }, LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" } };
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { try { await Api.InitialiseAsync(); StateHasChanged(); } catch (HubApiException) { } } }
}
