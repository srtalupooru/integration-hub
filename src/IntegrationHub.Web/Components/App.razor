@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@FileVersions.AddFileVersionToPath("/", "_content/IntegrationHub.Web/hub.css")" />
    <link rel="stylesheet" href="@FileVersions.AddFileVersionToPath("/", "_content/IntegrationHub.Web/workspace.css")" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <div id="blazor-error-ui">The connection was interrupted. <a href="">Reload the workspace</a></div>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/IntegrationHub.Web/hub.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
