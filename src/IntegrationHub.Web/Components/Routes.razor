<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>Page not found</h1><p>This page does not exist. <a href="/integrations">Return to the catalogue.</a></p></LayoutView></NotFound>
</Router>
