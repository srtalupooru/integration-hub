# Supply your own SQL Server credentials. This file is never loaded by the .NET host itself.
MSSQL_SA_PASSWORD=
# In Compose, the server hostname is sql,1433. Use the same password as above.
# Format: Server=sql,1433;Database=IntegrationHub;User Id=sa;Password=<your-password>;Encrypt=True;TrustServerCertificate=True
SQL_CONNECTION_STRING=
